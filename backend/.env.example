# ==========================================
# JanSetu Backend Environment Configuration
# ==========================================

# Primary LLM API Key (Groq)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional LLM Fallback (Google Gemini)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=

# Scheme Semantic Search (Qdrant)
# Leave QDRANT_URL blank to use fast, zero-setup local storage at backend/qdrant_storage
# For Qdrant Cloud, provide: https://<cluster-id>.qdrant.tech:6333
QDRANT_URL=
QDRANT_API_KEY=

# SQLite Database Location (relative to backend folder or absolute path)
SQLITE_PATH=../database/jansetu.db

# Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
